<routes>
    <vTypeDistribution id="mix_transito">
        
        <vType id="carro" probability="0.70" vClass="passenger" guiShape="passenger"
            accel="2.6" decel="4.5" length="5.0" maxSpeed="55.5" 
            minGap="2.5" sigma="0.7" 
            laneChangeModel="SL2015" lcStrategic="0.5" lcCooperative="0.0" lcPushy="0.8"/>

        <vType id="mota" probability="0.10" vClass="motorcycle" guiShape="motorcycle"
            accel="5.0" decel="6.0" length="2.2" width="0.9" maxSpeed="60.0"
            minGap="1.5" sigma="0.9"
            laneChangeModel="SL2015" lcStrategic="0.5" lcCooperative="0.0" lcPushy="1.0"/>

        <vType id="van" probability="0.10" vClass="delivery" guiShape="delivery"
            accel="2.0" decel="4.0" length="6.5" width="2.2" maxSpeed="45.0"
            minGap="2.5" sigma="0.6"
            laneChangeModel="SL2015" lcStrategic="0.5" lcCooperative="0.1" lcPushy="0.5"/>

        <vType id="camiao_trafego" probability="0.10" vClass="truck" guiShape="truck"
            accel="1.2" decel="3.0" length="12.0" width="2.5" maxSpeed="25.0"
            minGap="3.0" sigma="0.5"
            laneChangeModel="SL2015" lcStrategic="0.8" lcCooperative="0.2" lcPushy="0.2"/>   
    </vTypeDistribution>


    <vType id="maquina_camiao" vClass="truck" guiShape="truck" length="10" width="2.5" color="255,140,0"/>
    <vType id="maquina_escavadora" vClass="truck" guiShape="truck" length="7" width="2.5" color="255,255,0"/>
    <vType id="maquina_pavimentadora" vClass="truck" guiShape="truck" length="8" width="2.8" color="80,80,80"/>


    <route id="rota_ida" edges="edge_ida_1 edge_ida_2 edge_ida_3"/>
    <route id="rota_volta" edges="edge_volta_1"/>
    <route id="rota_obra" edges="edge_ida_2"/>


    <vehicle id="obra_camiao" type="maquina_camiao" route="rota_obra" depart="0" departPos="50" departSpeed="0" departLane="0" departPosLat="center">
        <stop lane="edge_ida_2_0" startPos="50" endPos="60" duration="3600" parking="false"/>
    </vehicle>

    <vehicle id="obra_escavadora" type="maquina_escavadora" route="rota_obra" depart="0" departPos="250" departSpeed="0" departLane="0" departPosLat="center">
        <stop lane="edge_ida_2_0" startPos="250" endPos="260" duration="3600" parking="false"/>
    </vehicle>

    <vehicle id="obra_pavimentadora" type="maquina_pavimentadora" route="rota_obra" depart="0" departPos="450" departSpeed="0" departLane="0" departPosLat="center">
        <stop lane="edge_ida_2_0" startPos="450" endPos="460" duration="3600" parking="false"/>
    </vehicle>


    <flow id="fluxo_ida" type="mix_transito" route="rota_ida" begin="0" end="3600" period="1.5" departLane="random" departSpeed="max"/>
    
    <flow id="fluxo_volta" type="mix_transito" route="rota_volta" begin="0" end="3600" period="5" departLane="random" departSpeed="max"/>

</routes>
