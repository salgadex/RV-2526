<configuration>
    <input>
        <net-file value="ROAD/mapa.net.xml"/>
        <route-files value="TRAFFIC/trafego.rou.xml"/>
        <additional-files value="ROAD/decoracao.add.xml"/>
    </input>
    
    <output>
        <tripinfo-output.write-unfinished value="true"/>
    </output>
    
    <time>
        <begin value="0"/>
        <end value="1000"/>
    </time>
</configuration>